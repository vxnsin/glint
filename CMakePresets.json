{
  "version": 6,
  "configurePresets": [
    {
      "name": "debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "GLINT_PLATFORM": "ON",
        "GLINT_SANITIZE": "ON"
      }
    },
    {
      "name": "release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "GLINT_PLATFORM": "ON"
      }
    },
    {
      "name": "hello",
      "description": "M0: the hello world without platform libraries, builds anywhere with a C++23 compiler",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/hello",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "GLINT_PLATFORM": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "hello", "configurePreset": "hello" }
  ]
}
