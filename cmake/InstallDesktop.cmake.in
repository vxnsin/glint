set(GLINT_BIN_DIR "@CMAKE_INSTALL_BINDIR@")
if(NOT IS_ABSOLUTE "${GLINT_BIN_DIR}")
    set(GLINT_BIN_DIR "${CMAKE_INSTALL_PREFIX}/${GLINT_BIN_DIR}")
endif()
set(GLINT_EXECUTABLE "${GLINT_BIN_DIR}/glint")
set(GLINT_DESKTOP_DIR "@CMAKE_INSTALL_DATADIR@/applications")
if(NOT IS_ABSOLUTE "${GLINT_DESKTOP_DIR}")
    set(GLINT_DESKTOP_DIR "${CMAKE_INSTALL_PREFIX}/${GLINT_DESKTOP_DIR}")
endif()
configure_file("@PROJECT_SOURCE_DIR@/integrations/desktop/glint.desktop.in"
               "@PROJECT_BINARY_DIR@/glint.desktop" @ONLY)
file(INSTALL DESTINATION "${GLINT_DESKTOP_DIR}"
     TYPE FILE FILES "@PROJECT_BINARY_DIR@/glint.desktop")
